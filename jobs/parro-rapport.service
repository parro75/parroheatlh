[Unit]
Description=Parro Health — rapport santé du matin (rédaction par Ollama ; annonce par l'appli Parro Health)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/parro-rapport/rapport_ia.py
# Rien à écrire : le job ne garde aucun état local (tout est sur le serveur).
DynamicUser=yes
LoadCredential=rapport.env:/etc/parro-sante/rapport.env
Environment=PARRO_ENV_FILE=%d/rapport.env
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
TimeoutStartSec=300
