[Unit]
Description=Parro Health - analyse des photos de repas par l'IA locale (photo effacee par le serveur apres analyse)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/parro-rapport/photo_repas.py
WorkingDirectory=/opt/parro-rapport
Restart=always
RestartSec=30
DynamicUser=yes
LoadCredential=rapport.env:/etc/parro-sante/rapport.env
Environment=PARRO_ENV_FILE=%d/rapport.env
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
