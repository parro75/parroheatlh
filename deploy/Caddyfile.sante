# Bloc à insérer dans le Caddyfile de l'hôte. Le service écoute sur un socket Unix (conteneur sans réseau) :
# monter /var/lib/sante-run sur /run/sante dans le conteneur Caddy.
# Données de santé RÉELLES : chaque route est ouverte explicitement, tout le reste répond 404.
sante.example.org {
	import accesslog   # plus aucun secret dans les chemins depuis OAuth ; Caddy masque l'en-tête Authorization
	import tls_dns
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-server
	}
	request_body {
		max_size 20MB
	}

	# Appels serveur à serveur de Claude (découverte OAuth, enregistrement, jetons, MCP) :
	# uniquement depuis les IP SORTANTES publiées par Anthropic
	# (https://platform.claude.com/docs/en/api/ip-addresses, relevé du 25/11/2026).
	@claude {
		path /mcp /register /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
		remote_ip 160.79.104.0/21 153.61.208.0/20
	}
	handle @claude {
		reverse_proxy unix//run/sante/shc.sock
	}

	# Job de rapport et Home Assistant : jamais par le nom public (voir le vhost interne en bas).
	# Ce bloc passe AVANT @app, sinon /api/v1/* les ouvrirait à tout Internet.
	@interne path /api/v1/report-job/* /api/v1/ha/*
	handle @interne {
		respond 404
	}

	# App Android Parro Health, de n'importe où (5G comprise) : échange et révocation de jetons OAuth
	# (PKCE, codes à usage unique) et API de lecture (jeton OAuth exigé). Les /token de Claude passent ici.
	@app path /token /revoke /api/v1/*
	handle @app {
		reverse_proxy unix//run/sante/shc.sock
	}

	# Navigateur du propriétaire, de n'importe où : protégé par mot de passe + TOTP.
	# + clés d'accès WebAuthn : options de connexion, gestion des clés (/passkeys), scripts de la page.
	@navigateur path /authorize /login /login/* /login.js /passkeys /passkeys/* /passkeys.js
	handle @navigateur {
		reverse_proxy unix//run/sante/shc.sock
	}

	# Téléphone (5G comprise) : jeton d'ingestion distinct, POST seulement.
	@ingest {
		method POST
		path /ingest
	}
	# Export Samsung Health envoyé par l'app, par morceaux de 15 Mio (limite de 20 Mo conservée).
	@ingest_export {
		method POST PUT GET
		path /ingest-export/*
	}
	handle @ingest_export {
		reverse_proxy unix//run/sante/shc.sock
	}
	handle @ingest {
		reverse_proxy unix//run/sante/shc.sock
	}

	handle {
		respond 404
	}
}

# Nom INTERNE, facultatif : job de rapport et Home Assistant, joignables seulement depuis tes réseaux
# (VPN, LAN). Le DNS interne fait pointer ce nom vers l'adresse VPN du serveur ; certificat par DNS-01.
# ⚠️ Adapter les plages à tes réseaux.
sante.lan.example.org {
	import tls_dns
	# ⚠️ Un filtre « respond @offnet 403 » serait IGNORÉ ici : Caddy exécute les blocs handle AVANT la
	# directive respond. Le filtre doit donc être lui-même un handle, placé en premier.
	@offnet not remote_ip 10.0.0.0/8 192.168.0.0/16
	handle @offnet {
		respond 403
	}
	@interne path /api/v1/report-job/* /api/v1/ha/*
	handle @interne {
		reverse_proxy unix//run/sante/shc.sock
	}
	handle {
		respond 404
	}
}
