# Bloc à insérer dans le Caddyfile de l'hôte (Caddy en réseau hôte).
# Données de santé RÉELLES : chaque route est ouverte explicitement, tout le reste répond 404.
sante.example.org {
	import accesslog   # plus aucun secret dans les chemins depuis OAuth ; Caddy masque l'en-tête Authorization
	import tls_dns
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-server
	}
	request_body {
		max_size 20MB
	}

	# Appels serveur à serveur de Claude (découverte OAuth, enregistrement, jetons, MCP) :
	# uniquement depuis les IP SORTANTES publiées par Anthropic
	# (https://platform.claude.com/docs/en/api/ip-addresses, relevé du 25/11/2026).
	@claude {
		path /mcp /token /register /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
		remote_ip 160.79.104.0/21 153.61.208.0/20
	}
	handle @claude {
		reverse_proxy 172.26.0.2:8080
	}

	# Navigateur du propriétaire, de n'importe où : protégé par mot de passe + TOTP.
	@navigateur path /authorize /login
	handle @navigateur {
		reverse_proxy 172.26.0.2:8080
	}

	# Téléphone (5G comprise) : jeton d'ingestion distinct, POST seulement.
	@ingest {
		method POST
		path /ingest
	}
	handle @ingest {
		reverse_proxy 172.26.0.2:8080
	}

	handle {
		respond 404
	}
}
