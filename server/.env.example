# Générer les trois secrets : docker compose run --rm -T shc python -m shc.admin init
# (le mot de passe est lu sur l'entrée standard ; seul son hachage scrypt est écrit ici)
INGEST_TOKEN=a-remplacer
OWNER_PASSWORD_HASH=a-remplacer
TOTP_SECRET=a-remplacer
PUBLIC_URL=https://sante.example.org
TZ_LOCAL=America/Toronto
DB_PATH=/data/health.db
# Par défaut : l'hôte de PUBLIC_URL (protection DNS rebinding) et les retours claude.ai/claude.com.
# MCP_ALLOWED_HOSTS=sante.example.org
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
